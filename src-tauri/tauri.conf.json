{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Neon HUD",
  "version": "0.1.1",
  "identifier": "io.github.ajaxcbcb.neonhud",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Neon HUD",
        "width": 280,
        "height": 56,
        "decorations": false,
        "visible": false,
        "resizable": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost ws://127.0.0.1:1420 http://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../LICENSE-MIT",
      "../LICENSE-APACHE",
      "../NOTICE",
      "../THIRD-PARTY-NOTICES.md",
      "../public/brands/LOBE-LICENSE"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFFRjYxNkUxODlBMTgyQjEKUldTeGdxR0o0UmIySG91ZS9QM1ZCaWkrQyttSzBCMktsTi9qVmlqYUt3WnFEbmpJYllZZnFMOUoK",
      "endpoints": [
        "https://raw.githubusercontent.com/ajaxcbcb/neon-hud/main/updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
